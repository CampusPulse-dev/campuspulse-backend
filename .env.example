# Copy to .env and fill in. Boot fails loudly on anything missing or malformed.

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Matches docker-compose.yml
DATABASE_URL="postgresql://campuspulse:campuspulse@localhost:5432/campuspulse?schema=public"
REDIS_URL="redis://localhost:6379"

# Both must be >=32 chars. Generate with: openssl rand -base64 48
JWT_SECRET="replace-me-with-at-least-32-characters-of-random"
JWT_EXPIRES_IN=7d

# Deliberately separate from JWT_SECRET: QR tokens outlive sessions
# and need to rotate on their own schedule.
QR_SIGNING_SECRET="replace-me-with-at-least-32-characters-of-random"

# CORS origin for the frontend.
WEB_ORIGIN="http://localhost:3000"
