# Copy to .env and fill in. Boot fails loudly on anything missing or malformed.

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Matches docker-compose.yml
DATABASE_URL="postgresql://campuspulse:campuspulse@localhost:5432/campuspulse?schema=public"
REDIS_URL="redis://localhost:6379"

# Both must be >=32 chars. Generate with: openssl rand -base64 48
JWT_SECRET="replace-me-with-at-least-32-characters-of-random"
JWT_EXPIRES_IN=15m
JWT_REFRESH_TTL_DAYS=30
# Optional, local dev only: lets seeded accounts (incl. staff) sign in with this password.
# Leave unset anywhere real; seeded accounts then have no usable password.
# SEED_USER_PASSWORD=

# Asymmetric Ed25519 QR signing key (PKCS#8 DER base64). Public key is derived for offline scanners.
# Generate with: node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
# Optional in local dev (falls back to deterministic dev seed from QR_SIGNING_SECRET); required in production.
QR_SIGNING_PRIVATE_KEY=""
QR_SIGNING_SECRET="replace-me-with-at-least-32-characters-of-random"

# CORS origin for the frontend.
WEB_ORIGIN="http://localhost:3000"

# X-Dev-User header fallback for local dev / e2e. Rejected automatically when NODE_ENV=production.
DEV_AUTH_ENABLED=true

# S3 / MinIO media storage (matches docker-compose.yml in local dev)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="campuspulse-media"
# Private bucket for student ID images (NDPA). Must NOT have a public-read policy.
S3_PRIVATE_BUCKET="campuspulse-private"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadminpassword"
S3_PUBLIC_BASE_URL="http://localhost:9000/campuspulse-media"
S3_FORCE_PATH_STYLE=true

# Optional Web Push VAPID keys (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:alerts@campuspulse.ng"

# Memory for development/tests; production requires resend and both values below.
EMAIL_TRANSPORT=memory
# RESEND_API_KEY=
# EMAIL_FROM="CampusPulse <alerts@campuspulse.ng>"
